PORT=3000

# Neon/Supabase/Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Telegram Bot API token from BotFather.
TELEGRAM_BOT_TOKEN="replace_me"

# Only this Telegram user can use the vault. Leave empty once to have the bot tell you your user id.
AUTHORIZED_TELEGRAM_USER_ID=""

# Server secret. It is mixed into the master password (a stolen database alone cannot be
# attacked) and it decrypts data saved before v2. Use a long random value and never change it:
# if you lose it, only your recovery code can open the vault.
VAULT_MASTER_KEY="replace_with_a_long_random_secret_at_least_32_chars"

# --- Optional -------------------------------------------------------------------------------

# Seconds before a message that reveals passwords deletes itself (10-3600).
SENSITIVE_MESSAGE_TTL_SECONDS=60

# Minutes without use before the open vault locks itself (1-60).
VAULT_UNLOCK_MINUTES=5

# Days between automatic encrypted backups sent to your chat (0 = off).
BACKUP_INTERVAL_DAYS=7

# Check passwords against Have I Been Pwned (only 5 characters of each hash leave the server).
PWNED_CHECK=true

# Time zone for the times the bot shows.
TIMEZONE="America/Mexico_City"

# Public HTTPS URL of the Mini App, ending in /app/. Empty = Mini App off.
WEBAPP_URL=""
